# Copy .env_example (or .env.example) to .env, then fill in your own values.
# Both example files contain the same settings. Never commit your real .env.

# Model provider: custom, ollama, or lmstudio.
LLM_PROVIDER=custom
LLM_MODEL_ID=your-model-name
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://your-api-host.example/v1
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.0

# Local models: select the provider, set LLM_MODEL_ID above,
# and leave LLM_BASE_URL blank to use its URL below.
# LLM_API_KEY may be blank if your local service does not require one.
# LOCAL_LLM=your-local-model-name
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# DuckDuckGo does not require an API key.
SEARCH_API=duckduckgo
# TAVILY_API_KEY=your-tavily-api-key
# SERPAPI_API_KEY=your-serpapi-api-key
# PERPLEXITY_API_KEY=your-perplexity-api-key
# For a running SearxNG instance:
# SEARXNG_URL=http://localhost:8888
FETCH_FULL_PAGE=False

# Research limits.
RESEARCH_MAX_TASKS=3
RESEARCH_MAX_ATTEMPTS=2
RESEARCH_MAX_STEPS=10
RESEARCH_MAX_RESULTS=3
RESEARCH_MAX_TOKENS_PER_SOURCE=2000
RESEARCH_PARALLEL_TASKS=True
RESEARCH_MAX_CONCURRENCY=3
RESEARCH_SEARCH_MAX_RETRIES=2
RESEARCH_SEARCH_RETRY_DELAY=1.0

# Server host/port are supplied through uvicorn command-line arguments.
